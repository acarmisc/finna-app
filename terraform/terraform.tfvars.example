# ---- Project Configuration ----
# Your GCP project ID
project_id = "my-finops-project"

# Primary region for all resources
region = "europe-west1"

# Zone for zonal resources
zone = "europe-west1-b"

# Resource name prefix (short, lowercase, hyphenated)
name = "finops"

# ---- Network ----
# CIDR range for the VPC subnet (adjust if it conflicts with existing ranges)
subnet_cidr = "10.8.0.0/20"

# ---- Database ----
# Cloud SQL machine tier:
#   Dev:     db-f1-micro (shared CPU, 0.6 GB)
#   Staging: db-custom-1-3840 (1 vCPU, 3.75 GB)
#   Prod:    db-custom-2-7680 (2 vCPU, 7.5 GB) with REGIONAL availability
db_tier = "db-f1-micro"

# ZONAL = single zone (dev), REGIONAL = HA with failover (prod)
availability_type = "ZONAL"

# Disk size in GB (auto-resize enabled)
db_disk_size = 20

# Database name created inside the Cloud SQL instance
db_name = "finops"

# Application database user
db_user = "finops_app"

# Application database password (USE A STRONG PASSWORD IN PRODUCTION)
db_password = "change-me-to-a-strong-password"

# ---- Docker Images ----
# These reference images pushed to the Artifact Registry repository
# Format: <region>-docker.pkg.dev/<project>/<repo>/<image>:<tag>
grafana_image   = "europe-west1-docker.pkg.dev/my-finops-project/finops-docker/grafana:latest"
bifrost_image   = "europe-west1-docker.pkg.dev/my-finops-project/finops-docker/bifrost:latest"
extractor_image = "europe-west1-docker.pkg.dev/my-finops-project/finops-docker/extractors:latest"

# ---- Secret Values (initial) ----
# These create the initial secret versions in Secret Manager.
# After initial apply, update secrets via gcloud or the Console.
# PG DSN format: postgresql://<user>:<password>@<private_ip>:5432/<db_name>?sslmode=disable
pg_dsn_value = "postgresql://finops_app:change-me@10.x.x.x:5432/finops?sslmode=disable"

# GCP service account key JSON for billing extraction (export from GCP IAM)
gcp_sa_key_value = ""

# Azure service principal credentials JSON for cost extraction
azure_credentials_value = ""

# Bifrost API keys (JSON)
bifrost_api_keys_value = ""

# Grafana admin password (set a strong password for production)
grafana_admin_password = "admin"

# ---- Service Scaling ----
# Grafana: min 1 keeps a warm instance; max 3 for burst
grafana_min_instances = 1
grafana_max_instances = 3

# Bifrost: min 1 keeps a warm instance; max 5 for burst
bifrost_min_instances = 1
bifrost_max_instances = 5

# ---- Schedules ----
# Cron format: minute hour day month weekday (UTC)
# GCP Billing: every 6 hours at :00
gcp_billing_schedule = "0 */6 * * *"

# Azure Cost: every 6 hours at :30 (offset from GCP billing)
azure_cost_schedule = "30 */6 * * *"

# Bifrost LLM: every hour at :00
bifrost_llm_schedule = "0 * * * *"

# Exchange Rates: once daily at 06:00 UTC
exchange_rates_schedule = "0 6 * * *"

# ---- Alerts ----
# Email for alerting notifications
alert_email = "finops-alerts@example.com"

# Slack webhook URL for alerting (optional)
slack_webhook_url = ""