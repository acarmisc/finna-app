# ---------------------------------------------------------------------------
# FinOps Orchestrator API — Backend Only
#
# Build:  docker build -f deploy/Dockerfile.api -t finops-api .
# Run:    docker run --rm -p 8000:8000 -e PG_DSN=... finops-api
# ---------------------------------------------------------------------------

# ---- Stage 1: Python builder ----
FROM python:3.12-slim AS builder

WORKDIR /build

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY pyproject.toml .
RUN uv pip install --system --no-cache -r pyproject.toml

# ---- Stage 2: Runtime ----
FROM python:3.12-slim

RUN groupadd --gid 1000 appuser && \
    useradd --uid 1000 --gid appuser --shell /bin/bash --create-home appuser

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy backend components
COPY backend/ ./backend/
COPY cli/ ./cli/
COPY resources/sql/ ./resources/sql/

# Note: Frontend static files are NOT included here. 
# Use the frontend container for UI serving.

ENV HOST=0.0.0.0
ENV PORT=8000
ENV PYTHONPATH=/app

USER appuser

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
