# Finna-App configuration template.
# Copy to .env and fill in values. Generate strong secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Postgres ---------------------------------------------------------------
POSTGRES_DB=finops
POSTGRES_USER=finops
POSTGRES_PASSWORD=change-me-strong-password

# --- API secrets (required, must be >=32 chars; never reuse dev values) -----
JWT_SECRET=change-me-generate-with-secrets.token_urlsafe-48
ENCRYPTION_KEY=change-me-generate-with-secrets.token_urlsafe-48

# --- CORS -------------------------------------------------------------------
# Comma-separated http(s):// origins. Wildcards ('*') are rejected at startup.
ALLOWED_ORIGINS=http://localhost:8080

# --- Migrations -------------------------------------------------------------
# Leave 'false' in production; flip to 'true' only for first-boot bootstrap.
AUTO_MIGRATE=false

# --- Sample data ------------------------------------------------------------
SEED_SAMPLE_DATA=false

# --- Optional: OIDC / GitHub OAuth -----------------------------------------
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:8000/auth/github/callback

# --- Optional: OpenTelemetry ------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
