{
  "dashboard": {
    "uid": "finops-configs",
    "title": "FinOps - Configurations & Extractors",
    "tags": [
      "finops",
      "configurations",
      "providers"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 0,
    "refresh": "30m",
    "templating": {
      "list": [
        {
          "name": "DS_POSTGRES",
          "type": "datasource",
          "label": "Datasource",
          "query": "postgres",
          "refresh": 1,
          "hide": 0,
          "current": {},
          "options": []
        },
        {
          "name": "provider",
          "type": "query",
          "label": "Provider",
          "query": "SELECT DISTINCT provider FROM cloud_config ORDER BY 1",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "refresh": 2,
          "includeAll": true,
          "multi": true,
          "hide": 0,
          "sort": 1,
          "current": {},
          "options": []
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Total Configurations",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 8,
          "x": 0,
          "y": 0
        },
        "datasource": {
          "type": "postgres",
          "uid": "${DS_POSTGRES}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            },
            "unit": "none"
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "last"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "datasource": {
              "type": "postgres",
              "uid": "${DS_POSTGRES}"
            },
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT COUNT(*) as value FROM cloud_config WHERE (provider IN ($provider))",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "Total Extractors",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 8,
          "x": 8,
          "y": 0
        },
        "datasource": {
          "type": "postgres",
          "uid": "${DS_POSTGRES}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            },
            "unit": "none"
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "last"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "datasource": {
              "type": "postgres",
              "uid": "${DS_POSTGRES}"
            },
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT COUNT(*) as value FROM extractors WHERE (provider IN ($provider))",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Configs with Errors",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 8,
          "x": 16,
          "y": 0
        },
        "datasource": {
          "type": "postgres",
          "uid": "${DS_POSTGRES}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 1
                }
              ]
            },
            "unit": "none"
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "last"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "datasource": {
              "type": "postgres",
              "uid": "${DS_POSTGRES}"
            },
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT COUNT(*) as value FROM cloud_config WHERE (last_test = 'failed' OR (err IS NOT NULL AND err != '')) AND (provider IN ($provider))",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Config Health Status",
        "type": "table",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 4
        },
        "datasource": {
          "type": "postgres",
          "uid": "${DS_POSTGRES}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "custom": {
              "align": "auto",
              "cellOptions": {
                "type": "auto"
              },
              "inspect": false
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "test_status"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "thresholds"
                  }
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "red",
                        "value": 3
                      }
                    ]
                  }
                },
                {
                  "id": "mappings",
                  "value": [
                    {
                      "options": {
                        "ok": {
                          "color": "green",
                          "text": "OK"
                        },
                        "error": {
                          "color": "red",
                          "text": "ERROR"
                        },
                        "pending": {
                          "color": "yellow",
                          "text": "PENDING"
                        }
                      },
                      "type": "value"
                    }
                  ]
                }
              ]
            }
          ]
        },
        "options": {
          "cellHeight": "sm",
          "footer": {
            "countRows": false,
            "enable_pagination": false,
            "fields": "",
            "reducer": [
              "sum"
            ],
            "show": false
          },
          "frameIndex": 0,
          "showHeader": true,
          "sortBy": [
            {
              "desc": false,
              "displayName": "provider"
            }
          ]
        },
        "targets": [
          {
            "datasource": {
              "type": "postgres",
              "uid": "${DS_POSTGRES}"
            },
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT\n  id,\n  provider,\n  name,\n  credential_type,\n  CASE\n    WHEN last_test IS NOT NULL AND last_test = 'success' THEN 'ok'\n    WHEN last_test = 'failed' OR (err IS NOT NULL AND err != '') THEN 'error'\n    ELSE 'pending'\n  END as test_status,\n  last_test_at,\n  err\nFROM cloud_config\nWHERE (provider IN ($provider))\nORDER BY provider, name",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Extractors by Provider",
        "type": "piechart",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 12
        },
        "datasource": {
          "type": "postgres",
          "uid": "${DS_POSTGRES}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "viz": false
              }
            },
            "mappings": []
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "right",
            "showLegend": true
          },
          "pieType": "pie",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "tooltip": {
            "mode": "single",
            "sort": "none"
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "postgres",
              "uid": "${DS_POSTGRES}"
            },
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT provider as metric, COUNT(*) as value FROM extractors WHERE (provider IN ($provider)) GROUP BY provider ORDER BY value DESC",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "Configs by Credential Type",
        "type": "piechart",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 12
        },
        "datasource": {
          "type": "postgres",
          "uid": "${DS_POSTGRES}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "viz": false
              }
            },
            "mappings": []
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "right",
            "showLegend": true
          },
          "pieType": "pie",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "tooltip": {
            "mode": "single",
            "sort": "none"
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "postgres",
              "uid": "${DS_POSTGRES}"
            },
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT credential_type as metric, COUNT(*) as value FROM cloud_config WHERE (provider IN ($provider)) GROUP BY credential_type ORDER BY value DESC",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "Extractor Status Overview",
        "type": "table",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 20
        },
        "datasource": {
          "type": "postgres",
          "uid": "${DS_POSTGRES}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "custom": {
              "align": "auto",
              "cellOptions": {
                "type": "auto"
              },
              "inspect": false
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "status"
              },
              "properties": [
                {
                  "id": "mappings",
                  "value": [
                    {
                      "options": {
                        "running": {
                          "color": "blue",
                          "text": "Running"
                        },
                        "idle": {
                          "color": "green",
                          "text": "Idle"
                        },
                        "error": {
                          "color": "red",
                          "text": "Error"
                        },
                        "disabled": {
                          "color": "yellow",
                          "text": "Disabled"
                        }
                      },
                      "type": "value"
                    }
                  ]
                }
              ]
            }
          ]
        },
        "options": {
          "cellHeight": "sm",
          "footer": {
            "countRows": false,
            "enable_pagination": false,
            "fields": "",
            "reducer": [
              "sum"
            ],
            "show": false
          },
          "frameIndex": 0,
          "showHeader": true,
          "sortBy": [
            {
              "desc": false,
              "displayName": "provider"
            }
          ]
        },
        "targets": [
          {
            "datasource": {
              "type": "postgres",
              "uid": "${DS_POSTGRES}"
            },
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT\n  e.id,\n  e.name,\n  e.provider,\n  e.extractor_type,\n  e.enabled,\n  e.status,\n  e.schedule,\n  c.name as config_name,\n  e.last_run_at\nFROM extractors e\nLEFT JOIN cloud_config c ON c.id = e.config_id\nWHERE (e.provider IN ($provider))\nORDER BY e.provider, e.name",
            "refId": "A"
          }
        ]
      }
    ],
    "time": {
      "from": "now-90d",
      "to": "now"
    },
    "timepicker": {}
  },
  "overwrite": true
}