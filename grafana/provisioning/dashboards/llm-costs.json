      },
      "id": 3,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": true
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "cost"
          }
        ]
      },
      "pluginVersion": "11.5.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "finops-pg"
          },
          "format": "table",
          "rawSql": "SELECT model_name, sum(total_cost) AS cost, sum(total_input_tokens) AS input_tok, sum(total_output_tokens) AS output_tok, sum(total_cost) / nullif(sum(total_input_tokens + total_output_tokens), 0) * 1e6 AS cost_per_mtok FROM daily_costs WHERE service_category = 'llm' AND day >= current_date - 30 AND project_id IN ($project_id) AND model_name IN ($model_name) GROUP BY model_name ORDER BY cost DESC",
          "refId": "A"
        }
      ],
      "title": "Model Cost & Token Efficiency",
      "type": "table"
    },
