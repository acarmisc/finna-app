          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH current_mtd AS (\n  SELECT SUM(COALESCE(NULLIF(net_cost_usd, 0), cost_usd)) as curr\n  FROM cost_records\n  WHERE usage_start >= date_trunc('month', current_date)\n    AND usage_start < date_trunc('day', current_date) + INTERVAL '1 day'\n),\nprev_mtd AS (\n  SELECT SUM(COALESCE(NULLIF(net_cost_usd, 0), cost_usd)) as prev\n  FROM cost_records\n  WHERE usage_start >= date_trunc('month', current_date) - INTERVAL '1 month'\n    AND usage_start < date_trunc('month', current_date)\n)\nSELECT\n  COALESCE(((c.curr - p.prev) / NULLIF(p.prev, 0)) * 100, 0) as value\nFROM current_mtd c, prev_mtd p",
          "refId": "A",
          "table": "cost_records",
          "timeColumn": "usage_start",
          "timeColumnType": "timestamptz",
          "where": [
            {
              "name": "$__timeFilter",
              "params": [],
              "type": "macro"
