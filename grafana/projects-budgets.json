      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  id,\n  name,\n  slug,\n  owner,\n  cost_center,\n  budget_cap,\n  COALESCE(SUM(COALESCE(NULLIF(c.net_cost_usd, 0), c.cost_usd)), 0) as mtd,\n  tags,\n  provider,\n  CASE\n    WHEN budget_cap IS NOT NULL AND COALESCE(SUM(COALESCE(NULLIF(c.net_cost_usd, 0), c.cost_usd)), 0) > budget_cap THEN 'over'\n    WHEN budget_cap IS NOT NULL AND COALESCE(SUM(COALESCE(NULLIF(c.net_cost_usd, 0), c.cost_usd)), 0) / budget_cap >= 0.9 THEN 'warning'\n    ELSE 'ok'\n  END as status\nFROM fin_projects p\nLEFT JOIN cost_records c ON c.project_id = p.slug\n  AND c.usage_start >= date_trunc('month', current_date)\n  AND c.usage_start < date_trunc('day', current_date) + INTERVAL '1 day'\nGROUP BY 1, 2, 3, 4, 5, 6, 8, 9\nORDER BY mtd DESC",
          "refId": "A",
          "table": "fin_projects",
          "timeColumn": "updated_at",
          "timeColumnType": "timestamptz",
          "where": [
            {
              "name": "$__timeFilter",
              "params": [],
              "type": "macro"
            }
          ]
        }
