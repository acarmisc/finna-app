          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(SUM(COALESCE(NULLIF(c.net_cost_usd, 0), c.cost_usd)), 0) as value\nFROM fin_projects p\nLEFT JOIN cost_records c ON c.project_id = p.slug\nWHERE\n  c.usage_start >= date_trunc('month', current_date)\n  AND c.usage_start < date_trunc('day', current_date) + INTERVAL '1 day'",
