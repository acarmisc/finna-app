            "uid": "${DS_POSTGRES}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  er.id as extractor_id,\n  er.name as extractor_name,\n  er.provider,\n  er.schedule,\n  COUNT(erun.id) as run_count,\n  MAX(erun.finished_at) as last_run,\n  CASE\n    WHEN MAX(erun.status) = 'success' THEN 'success'\n    WHEN MAX(erun.status) = 'failed' THEN 'failed'\n    ELSE 'partial'\n  END as last_status\nFROM extractors er\nLEFT JOIN extractor_runs erun ON erun.config_id IN (\n  SELECT config_id FROM extractors WHERE id = er.id\n)\nGROUP BY 1, 2, 3, 4\nORDER BY run_count DESC",
          "refId": "A",
          "table": "extractors",
          "timeColumn": "updated_at",
          "timeColumnType": "timestamptz",
          "where": [
            {
              "name": "$__timeFilter",
