          "rawQuery": true,
          "rawSql": "SELECT\n  c.id as config_id,\n  c.provider,\n  c.name,\n  c.credential_type,\n  COUNT(e.id) as extractor_count,\n  CASE\n    WHEN MAX(e.updated_at) IS NOT NULL THEN MAX(e.updated_at)\n    ELSE c.updated_at\n  END as last_activity\nFROM cloud_config c\nLEFT JOIN extractors e ON e.config_id = c.id\nGROUP BY 1, 2, 3, 4\nORDER BY extractor_count DESC",
          "refId": "A",
          "table": "cloud_config",
