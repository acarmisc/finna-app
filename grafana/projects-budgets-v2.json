          {
            "datasource": {
              "type": "postgres",
              "uid": "dfon7cdkmcs8wa"
            },
            "format": "table",
            "rawQuery": true,
            "rawSql": "WITH real_mtd AS (\n  SELECT project_id, SUM(net_cost_usd) as mtd\n  FROM cost_records\n  WHERE usage_start >= date_trunc('month', current_date)\n  GROUP BY project_id\n)\nSELECT COALESCE(SUM(r.mtd), 0)::numeric as value\nFROM fin_projects p\nLEFT JOIN real_mtd r ON r.project_id = p.slug\nWHERE (p.provider IN ($provider))",
            "refId": "A"
          }
        ]
