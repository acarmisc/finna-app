        "targets": [
          {
            "datasource": {
              "type": "postgres",
              "uid": "dfon7cdkmcs8wa"
            },
            "format": "table",
            "rawQuery": true,
            "rawSql": "WITH real_mtd AS (\n  SELECT project_id, SUM(net_cost_usd) as mtd\n  FROM cost_records\n  WHERE usage_start >= date_trunc('month', current_date)\n  GROUP BY project_id\n)\nSELECT\n  p.name,\n  p.slug,\n  p.owner,\n  p.cost_center,\n  p.budget_cap,\n  COALESCE(r.mtd, 0) as mtd,\n  CASE WHEN p.budget_cap > 0 THEN ROUND((COALESCE(r.mtd, 0) / NULLIF(p.budget_cap, 0) * 100)::numeric, 1) ELSE 0 END as utilization_pct,\n  CASE WHEN p.budget_cap > 0 AND COALESCE(r.mtd, 0) > p.budget_cap THEN (COALESCE(r.mtd, 0) - p.budget_cap)::numeric ELSE 0 END as over_amount\nFROM fin_projects p\nLEFT JOIN real_mtd r ON r.project_id = p.slug\nWHERE (p.provider IN ($provider))\nORDER BY r.mtd DESC NULLS LAST",
            "refId": "A"
          }
        ]
