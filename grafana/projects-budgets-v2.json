            "format": "table",
            "rawQuery": true,
            "rawSql": "WITH real_mtd AS (\n  SELECT project_id, SUM(net_cost_usd) as mtd\n  FROM cost_records\n  WHERE usage_start >= date_trunc('month', current_date)\n  GROUP BY project_id\n)\nSELECT\n  p.name as metric,\n  (COALESCE(r.mtd, 0) - p.budget_cap)::numeric as value\nFROM fin_projects p\nLEFT JOIN real_mtd r ON r.project_id = p.slug\nWHERE p.budget_cap > 0 AND COALESCE(r.mtd, 0) > p.budget_cap\n  AND (p.provider IN ($provider))\nORDER BY value DESC\nLIMIT 20",
