            "format": "table",
            "rawQuery": true,
            "rawSql": "WITH totals AS (\n  SELECT SUM(COALESCE(NULLIF(net_cost_usd, 0), cost_usd)) as total_cost,\n         SUM(total_tokens) as total_tokens\n  FROM cost_records\n  WHERE provider = 'llm'\n    AND usage_start >= date_trunc('month', current_date)\n    AND (model_name IN ($model) OR model_name IS NULL)\n  AND (COALESCE(project_name, '(no project)') IN ($project))\n)\nSELECT ROUND((total_cost / NULLIF(total_tokens, 0) * 1000000)::numeric, 2) as cost_per_1m\nFROM totals",
