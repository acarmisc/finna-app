            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT ROUND(SUM(COALESCE(NULLIF(net_cost_usd, 0), cost_usd))::numeric, 2) as mtd\nFROM cost_records\nWHERE provider = 'llm'\n  AND usage_start >= date_trunc('month', current_date)\n  AND (model_name IN ($model) OR model_name IS NULL)\n  AND (COALESCE(project_name, '(no project)') IN ($project))",
