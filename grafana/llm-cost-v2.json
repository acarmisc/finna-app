        "targets": [
          {
            "datasource": {
              "type": "postgres",
              "uid": "efothkw3y68sgb"
            },
            "format": "table",
            "rawQuery": true,
            "rawSql": "WITH days_elapsed AS (\n  SELECT EXTRACT(DAY FROM current_date)::int AS n\n),\nmtd AS (\n  SELECT SUM(COALESCE(NULLIF(net_cost_usd, 0), cost_usd)) as val\n  FROM cost_records, days_elapsed\n  WHERE provider = 'llm'\n    AND usage_start >= date_trunc('month', current_date)\n    AND usage_start < date_trunc('month', current_date) + (n || ' days')::interval\n    AND (model_name IN ($model) OR model_name IS NULL)\n  AND (COALESCE(project_name, '(no project)') IN ($project))\n),\nprev AS (\n  SELECT SUM(COALESCE(NULLIF(net_cost_usd, 0), cost_usd)) as val\n  FROM cost_records, days_elapsed\n  WHERE provider = 'llm'\n    AND usage_start >= date_trunc('month', current_date - INTERVAL '1 month')\n    AND usage_start < date_trunc('month', current_date - INTERVAL '1 month') + (n || ' days')::interval\n    AND (model_name IN ($model) OR model_name IS NULL)\n  AND (COALESCE(project_name, '(no project)') IN ($project))\n)\nSELECT ROUND(((mtd.val - prev.val) / NULLIF(prev.val, 0)) * 100, 2) as growth\nFROM mtd, prev",
            "refId": "A"
          }
        ]
      },
