            "rawQuery": true,
            "rawSql": "SELECT\n  r.id,\n  r.provider,\n  r.extractor_type,\n  r.status,\n  r.started_at,\n  r.finished_at,\n  r.records_extracted,\n  r.error_message\nFROM extractor_runs r\nWHERE (r.provider IN ($provider))\n  AND (r.status IN ($status))\nORDER BY r.started_at DESC\nLIMIT 100",
