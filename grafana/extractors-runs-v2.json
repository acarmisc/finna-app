        "targets": [
          {
            "datasource": {
              "type": "postgres",
              "uid": "efothkw3y68sgb"
            },
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT\n  provider,\n  MAX(ingestion_ts)::timestamp as last_ingested,\n  ROUND(EXTRACT(EPOCH FROM (now() - MAX(ingestion_ts))) / 3600, 1) as staleness_hours,\n  MIN(usage_start)::date as oldest_data,\n  MAX(usage_start)::date as newest_data,\n  COUNT(*) as total_records\nFROM cost_records\nWHERE (provider IN (SELECT DISTINCT provider FROM cost_records))\nGROUP BY provider\nORDER BY staleness_hours DESC",
            "refId": "A"
          }
        ]
