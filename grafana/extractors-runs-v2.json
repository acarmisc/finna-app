        "targets": [
          {
            "datasource": {
              "type": "postgres",
              "uid": "efothkw3y68sgb"
            },
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT\n  e.name,\n  e.provider,\n  e.extractor_type,\n  COUNT(r.id) as total_runs,\n  COALESCE(SUM(r.records_extracted), 0) as total_records,\n  COALESCE(ROUND(AVG(r.records_extracted)::numeric, 0), 0) as avg_records,\n  CASE WHEN COUNT(r.id) > 0 THEN ROUND(COUNT(*) FILTER (WHERE r.status = 'success')::numeric / COUNT(*) * 100, 1) ELSE 0 END as success_rate,\n  MAX(r.started_at) as last_run\nFROM extractors e\nLEFT JOIN extractor_runs r ON r.config_id = e.config_id\nWHERE (e.provider IN ($provider))\n  AND (e.extractor_type IN ($extractor_type))\nGROUP BY e.name, e.provider, e.extractor_type\nORDER BY total_records DESC",
            "refId": "A"
          }
        ]
