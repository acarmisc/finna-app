        },
        "targets": [
          {
            "datasource": {
              "type": "postgres",
              "uid": "efothkw3y68sgb"
            },
            "format": "time_series",
            "rawQuery": true,
            "rawSql": "SELECT\n  DATE(usage_start) as time,\n  provider as metric,\n  ROUND(AVG(EXTRACT(EPOCH FROM (ingestion_ts - usage_end)) / 3600)::numeric, 2) as value\nFROM cost_records\nWHERE\n  $__timeFilter(usage_start)\n  AND ingestion_ts IS NOT NULL\n  AND (provider IN ($provider))\nGROUP BY 1, 2\nORDER BY 1, 2",
