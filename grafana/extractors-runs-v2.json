            "rawSql": "SELECT\n  CASE WHEN COUNT(*) = 0 THEN 0\n    ELSE ROUND(COUNT(*) FILTER (WHERE status = 'failed')::numeric / COUNT(*) * 100, 1)\n  END as value\nFROM extractor_runs\nWHERE (provider IN ($provider))\n  AND (status IN ($status))",
